# ==============================================================================
# Cliente Frontend (Vite + TypeScript)
# ==============================================================================
# URL base del servidor backend de NestJS
VITE_API_URL=http://localhost:3000

# Firebase Web / Cloud Messaging (opcional hasta configurar notificaciones push)
VITE_FIREBASE_API_KEY=tu-api-key-web
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-project-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu-sender-id
VITE_FIREBASE_APP_ID=tu-app-id
VITE_FIREBASE_VAPID_KEY=tu-clave-publica-vapid
