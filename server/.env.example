# Puerto del servidor backend
PORT=3000

# ==============================================================================
# Supabase Configuration
# Obtén estos valores en tu panel de Supabase:
# https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# URL de tu proyecto de Supabase (Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública 'anon' (Project API keys -> anon public)
SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave secreta 'service_role' (Project API keys -> service_role secret)
# Necesaria para operaciones administrativas y gestión de perfiles sin restricciones
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

