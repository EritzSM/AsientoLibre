# Puerto del servidor backend
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Supabase Configuration
# Obtén estos valores en tu panel de Supabase:
# https://supabase.com/dashboard/project/_/settings/api
# ==============================================================================

# URL de tu proyecto de Supabase (Project URL)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública actual (Project API keys -> Publishable key)
SUPABASE_PUBLISHABLE_KEY=tu-publishable-key-aqui

# Clave secreta actual (Project API keys -> Secret key)
# Necesaria para operaciones administrativas y gestión de perfiles sin restricciones
SUPABASE_SECRET_KEY=tu-secret-key-aqui

# También se admiten SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY en proyectos antiguos.

# Correo transaccional (opcional en desarrollo)
BREVO_API_KEY=xkeysib-tu-api-key-aqui
BREVO_SENDER_EMAIL=remitente-verificado@ejemplo.com
BREVO_SENDER_NAME=Asiento Libre

# Enlaces incluidos en los correos
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:3000
