# ==============================================================================
# Servidor Backend (NestJS)
# ==============================================================================
PORT=3000

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Obtén estos valores en tu panel de Supabase:
# Project Settings -> API (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ==============================================================================
# Brevo (Sendinblue) — Envío de correos transaccionales
# ==============================================================================
# 1. Crea una cuenta gratuita en https://brevo.com
# 2. Ve a Perfil -> SMTP y API -> pestaña "Claves API" (https://app.brevo.com/settings/keys/api)
# 3. Genera una nueva clave API y pégala debajo:
BREVO_API_KEY=xkeysib-tu_api_key_aqui

# Correo remitente validado en tu cuenta de Brevo (por defecto, tu correo de registro):
BREVO_SENDER_EMAIL=tu_correo@ejemplo.com

# Nombre visible del remitente para los usuarios:
BREVO_SENDER_NAME=Asiento Libre

# ==============================================================================
# URLs de la Aplicación
# ==============================================================================
# URL del frontend para redirecciones y CORS
FRONTEND_URL=http://localhost:5173

# URL del backend para construir enlaces en los correos
BACKEND_URL=http://localhost:3000
